# Copy to .env.local for local development and fill in real values.
# Never commit .env.local. On Vercel, set the same names under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=
# The publishable key (sb_publishable_...) or the legacy anon key. Used for the
# admin login; Row Level Security limits it to signed-in admins.
SUPABASE_PUBLISHABLE_KEY=

# Telegram: token from @BotFather, chat id of the owner (who pressed Start in the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
